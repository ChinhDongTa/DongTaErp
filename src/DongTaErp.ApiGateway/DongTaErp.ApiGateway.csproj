<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Refit" Version="9.0.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DongTaErp.AppHost\DongTaErp.AppHost.ServiceDefaults\DongTaErp.AppHost.ServiceDefaults.csproj" />
    <ProjectReference Include="..\DongTaErp.Infrastructure\DongTaErp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Swagger">
      <Generator>RefitterCodeGenerator</Generator>
    </None>
    <None Update="Swagger.com">
      <Generator>RefitterCodeGenerator</Generator>
    </None>
  </ItemGroup>

</Project>
