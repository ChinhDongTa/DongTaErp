@page "/purchase-orders/view/{Id}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.PurchaseOrders
@inject IPurchaseOrderService Service
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Đơn mua</PageTitle>
<Alert @ref="alert" />

@if (dto is null)
{
    <FluentSpinner />
}
else
{
    <ActionTitle Text="@dto.Number" />
    <FluentMessageBar Intent="MessageBarIntent.Info" Style="margin-bottom: 12px;">
        Kho đề xuất: @dto.WarehouseName. Xác nhận đơn chỉ khóa chứng từ. Hàng vào kho khi ghi sổ phiếu nhập.
    </FluentMessageBar>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Style="margin-bottom: 12px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Nhà cung cấp" Value="@dto.PartnerName" />
            <DetailItem Label="Kho đề xuất" Value="@dto.WarehouseName" />
            <DetailItem Label="Ngày" Value="@dto.OrderDate.ToVnDate()" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Trạng thái" Value="@dto.StatusName" />
            <DetailItem Label="Tổng" Value="@dto.Total.ToVND()" />
            <DetailItem Label="Ghi chú" Value="@dto.Notes" />
        </FluentStack>
    </FluentStack>

    <FluentDataGrid Items="@dto.Lines.AsQueryable()" Style="width: 100%;">
        <PropertyColumn Title="Mã SP" Property="@(c => c.ProductSku)" />
        <PropertyColumn Title="Sản phẩm" Property="@(c => c.ProductName)" />
        <PropertyColumn Title="Số lượng" Property="@(c => c.Qty.ToDisplay())" Align="DataGridCellAlignment.End" />
        <PropertyColumn Title="Đơn giá" Property="@(c => c.UnitPrice.ToVND())" Format="N0" Align="DataGridCellAlignment.End" />
        <PropertyColumn Title="Thành tiền" Property="@(c => c.LineTotal.ToVND())" Format="N0" Align="DataGridCellAlignment.End" />
    </FluentDataGrid>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 16px;">
        @if (dto.Status == PurchaseOrderStatus.Draft)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="busy" OnClick="ConfirmAsync">Xác nhận</FluentButton>
        }
        @if (dto.Status == PurchaseOrderStatus.Confirmed)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateReceipt">Tạo phiếu nhập</FluentButton>
        }
        @if (dto.Status != PurchaseOrderStatus.Cancelled)
        {
            <FluentButton Appearance="ButtonAppearance.Outline" Loading="busy" OnClick="CancelAsync">Hủy đơn</FluentButton>
        }
        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => Navigation.NavigateTo("/purchase-orders/list"))">Danh sách</FluentButton>
    </FluentStack>
}

@code {
    [Parameter] public required string Id { get; set; }

    private PurchaseOrderDto? dto;
    private Alert? alert;
    private bool busy;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Service.GetByIdAsync(Id.ToGuid());
        dto = result.Succeeded ? result.Value : null;
        if (dto is null)
            alert?.AddAlertError("Không tìm thấy đơn mua.");
    }

    private async Task ConfirmAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            "Xác nhận đơn mua? Sau bước này mới được tạo phiếu nhập.",
            title: "Xác nhận đơn",
            primaryButton: "Xác nhận",
            secondaryButton: "Hủy");
        if (dialog.Cancelled)
            return;

        busy = true;
        var result = await Service.ConfirmAsync(Id.ToGuid());
        busy = false;
        if (!result.Succeeded)
        {
            alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không xác nhận được.");
            return;
        }
        await LoadAsync();
    }

    private async Task CancelAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            "Hủy đơn mua này?",
            title: "Hủy đơn",
            primaryButton: "Hủy đơn",
            secondaryButton: "Không");
        if (dialog.Cancelled)
            return;

        busy = true;
        var result = await Service.CancelAsync(Id.ToGuid());
        busy = false;
        if (!result.Succeeded)
        {
            alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không hủy được đơn.");
            return;
        }
        await LoadAsync();
    }

    private void CreateReceipt() => Navigation.NavigateTo("/goods-receipts/create");
}
