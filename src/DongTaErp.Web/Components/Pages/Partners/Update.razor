@page "/partners/update/{Id}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Partners

@inject IPartnerService PartnerService
@inject NavigationManager Navigation

<PageTitle> Cập nhật đối tác</PageTitle>

<Alert @ref="alertComponent" />
@if (dto is null)
{
    <FluentSpinner />
}
else
{
    <ActionTitle Text="Cập nhật đối tác" />
    <EditForm Model="dto" OnSubmit="SaveAsync" Style="@(isSaving ? "opacity:.6; pointer-events:none;" : null)">
        <DataAnnotationsValidator />
        <FluentValidationSummary />
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Left" VerticalGap="10" Style="margin:10px auto;">
            <FluentTextInput @bind-Value="dto.Code" Label="Mã khách hàng" Placeholder="Nhập mã khách hàng" MaxLength="40" />
            <FluentTextInput @bind-Value="dto.Name" Label="Tên khách hàng" Placeholder="Nhập tên khách hàng" MaxLength="200" class="text200" />
            <FluentSelect TOption="PartnerType?" TValue="PartnerType?"  Items="partnerTypes"  OptionText="@(t => t?.ToDisplayName())" @bind-Value="dto.Type"  Label="Loại khách hàng" />
            <FluentTextInput @bind-Value="dto.Phone" Label="Điện thoại" MaxLength="40" />
            <FluentTextInput @bind-Value="dto.Email" Label="Email" MaxLength="160" TextInputType="TextInputType.Email" />
            <FluentTextInput @bind-Value="dto.TaxCode" Label="Mã số thuế" MaxLength="40" />
            <FluentTextInput @bind-Value="dto.Address" Label="Địa chỉ" class="text200" />
            <FluentCheckbox @bind-Value="dto.IsActive" Label="Kích hoạt" />
            <FormActionButtons IsSaving="@isSaving" SaveText="Lưu" CancelUrl="/partners/list" />
        </FluentStack>
    </EditForm>
}
@code {
    [Parameter] public required string Id { get; set; }
    private Alert? alertComponent;
    private bool isSaving;
    UpdatePartnerDto? dto;
    private static readonly IReadOnlyList<PartnerType?> partnerTypes = Enum.GetValues<PartnerType>().Cast<PartnerType?>().ToList();

    protected override async Task OnParametersSetAsync()
    {
        if(string.IsNullOrWhiteSpace(Id))
        {
            alertComponent?.AddAlertError("Id không hợp lệ.");
        }
        var result = await PartnerService.GetUpdateByIdAsync(Id.ToGuid());
        if (result.Succeeded && result.Value != null)
        {
            dto = result.Value;
        }
        else
        {
            alertComponent?.AddAlertError("Không tìm thấy đối tác.");
        }
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        if (dto is null)
        {
            alertComponent?.AddAlertError("Dữ liệu không hợp lệ.");
            return;
        }
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await PartnerService.UpdateAsync(Id.ToGuid(),dto);
            if (!result.Succeeded)
            {
                alertComponent?.AddAlertError(result.Errors?.ToLine("--") ?? "Cập nhật khách hàng thất bại.");
                return;
            }
            Navigation.NavigateTo($"/partners/view/{Id}");
        }
        finally
        {
            isSaving = false;
        }
    }
}