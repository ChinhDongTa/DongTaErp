@page "/categories/list"
@attribute [Authorize(Roles = AppRoles.Catalog)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Categories
@inject NavigationManager Navigation
@inject ICategoryService Service

<PageTitle>Danh mục</PageTitle>
<ActionTitle Text="Danh mục" />

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin: 8px 0 12px;">
    <FluentTextInput @bind-Value="searchTerm" Placeholder="Mã, tên danh mục" Style="width: 280px;" @onkeypress="OnSearchKey" />
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchAsync">Tìm</FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Primary" OnClick="@(() => Navigation.NavigateTo("/categories/create"))">Tạo danh mục</FluentButton>
</FluentStack>

<PaginatedTable TItem="CategoryDto" Data="page" PageSize="pageSize"
                GridTemplateColumns="1fr 1.4fr 1.6fr 1.4fr .8fr"
                OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
    <PropertyColumn TGridItem="CategoryDto" TProp="string" Title="Mã" Property="@(c => c!.Code)" />
    <PropertyColumn TGridItem="CategoryDto" TProp="string" Title="Tên" Property="@(c => c!.Name)" />
    <PropertyColumn TGridItem="CategoryDto" TProp="string" Title="Loại" Property="@(c => c!.CategoryType)" />
    <PropertyColumn TGridItem="CategoryDto" TProp="string?" Title="Cha" Property="@(c => c!.ParentName)" />
    <TemplateColumn TGridItem="CategoryDto" Title="Thao tác" Context="item">
        <FluentButton IconStart="@(new Icons.Regular.Size20.Eye())" Appearance="ButtonAppearance.Primary" Title="Xem" @onclick="@(() => Navigation.NavigateTo($"/categories/view/{item.Id}"))" />
        <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" Appearance="ButtonAppearance.Primary" Title="Sửa" @onclick="@(() => Navigation.NavigateTo($"/categories/update/{item.Id}"))" />
    </TemplateColumn>
</PaginatedTable>

@code {
    private PaginatedList<CategoryDto>? page;
    private readonly int pageSize = Models.Constants.PageSize;
    private int currentPage = 1;
    private bool isLoading;
    private int requestVersion;
    private string? searchTerm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadData(1);
    }

    private Task LoadPageAsync(int pageNumber)
    {
        currentPage = pageNumber;
        return LoadData(pageNumber);
    }

    private Task SearchAsync()
    {
        currentPage = 1;
        return LoadData(1);
    }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task LoadData(int pageNumber)
    {
        var version = ++requestVersion;
        isLoading = true;
        try
        {
            var result = await Service.SearchAsync(searchTerm, pageNumber, pageSize);
            if (version == requestVersion && result.Succeeded)
                page = result.Value;
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
