@page "/categories/update/{Id}"
@attribute [Authorize(Roles = AppRoles.Catalog)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Categories
@inject NavigationManager Navigation
@inject ICategoryService Service

<PageTitle>Cập nhật danh mục</PageTitle>
<Alert @ref="alert" />

@if (dto is null)
{
    <PageLoading />
}
else
{
    <ActionTitle Text="Cập nhật danh mục" />
    <EditForm Model="dto" OnSubmit="SaveAsync">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Style="max-width: 520px;">
            <FluentSelect TOption="LookupItemDto" TValue="string" Items="types" OptionText="@(x => x.Label)" OptionValue="@(x => x.Id.ToString())"
                          @bind-Value="typeId" Label="Loại danh mục" />
            <FluentTextInput @bind-Value="dto.Code" Label="Mã" />
            <FluentTextInput @bind-Value="dto.Name" Label="Tên" />
            <FluentSelect TOption="LookupItemDto" TValue="string" Items="parents" OptionText="@(x => x.Label)" OptionValue="@(x => x.Id.ToString())"
                          @bind-Value="parentId" Label="Danh mục cha" />
            <FormActionButtons IsSaving="@isSaving" SaveText="Lưu" CancelUrl="/categories/list" />
        </FluentStack>
    </EditForm>
}

@code {
    [Parameter] public required string Id { get; set; }
    private Alert? alert;
    private bool isSaving;
    private UpdateCategoryDto? dto;
    private List<LookupItemDto> types = [];
    private List<LookupItemDto> parents = [];
    private string typeId = "";
    private string parentId = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        types = (await Service.GetTypesAsync()).Value ?? [];
        parents = ((await Service.GetParentsAsync()).Value ?? []).Where(x => x.Id != Id.ToGuid()).ToList();
        var result = await Service.GetUpdateByIdAsync(Id.ToGuid());
        if (!result.Succeeded || result.Value is null)
        {
            alert?.AddAlertError("Không tìm thấy danh mục.");
            return;
        }
        dto = result.Value;
        typeId = dto.CategoryTypeId?.ToString() ?? "";
        parentId = dto.ParentId?.ToString() ?? "";
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAsync()
    {
        if (dto is null)
            return;
        dto.CategoryTypeId = Guid.TryParse(typeId, out var type) ? type : null;
        dto.ParentId = Guid.TryParse(parentId, out var parent) ? parent : null;
        isSaving = true;
        var result = await Service.UpdateAsync(Id.ToGuid(), dto);
        isSaving = false;
        if (!result.Succeeded)
        {
            alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không cập nhật được.");
            return;
        }
        Navigation.NavigateTo($"/categories/view/{Id}");
    }
}
