@page "/hr/payrolls/view/{Id}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Payrolls
@inject IPayrollService Service
@inject NavigationManager Navigation

<PageTitle>Bảng lương</PageTitle>
<Alert @ref="alert" />

@if (dto is null)
{
    <PageLoading />
}
else
{
    <ActionTitle Text="@dto.EmployeeName" />
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Kỳ" Value="@($"{dto.PeriodStartDate:dd/MM/yyyy} - {dto.PeriodEndDate:dd/MM/yyyy}")" />
            <DetailItem Label="Lương cơ bản" Value="@dto.BaseSalary.ToCurrency()" />
            <DetailItem Label="Ngày công" Value="@dto.DaysWorked.ToDisplay()" />
            <DetailItem Label="Tăng ca" Value="@((dto.OvertimeAmount ?? 0).ToCurrency())" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Thưởng" Value="@((dto.BonusAmount ?? 0).ToCurrency())" />
            <DetailItem Label="Khấu trừ" Value="@((dto.Deductions ?? 0).ToCurrency())" />
            <DetailItem Label="Thực lãnh" Value="@dto.NetAmount.ToCurrency()" />
            <DetailItem Label="Trạng thái" Value="@dto.PaymentStatusName" />
        </FluentStack>
    </FluentStack>
    <FluentButton Appearance="ButtonAppearance.Subtle" Style="margin-top: 16px;" OnClick="@(() => Navigation.NavigateTo("/hr/payrolls/list"))">Danh sách</FluentButton>
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => Navigation.NavigateTo($"/hr/payrolls/update/{dto.Id}"))">Sửa</FluentButton>
}

@code {
    [Parameter] public required string Id { get; set; }
    private PayrollDto? dto;
    private Alert? alert;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Service.GetByIdAsync(Id.ToGuid());
        dto = result.Succeeded ? result.Value : null;
        if (dto is null)
            alert?.AddAlertError("Không tìm thấy bảng lương.");
    }
}
