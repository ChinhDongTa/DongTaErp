@page "/hr/payrolls/update/{Id}"
@attribute [Authorize(Roles = AppRoles.Hr)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Payrolls
@using DongTaErp.Application.Services.Lookups
@using DongTaErp.Application.Services.SalaryComponents
@inject IPayrollService Service
@inject ILookupService Lookup
@inject ISalaryComponentService Components
@inject NavigationManager Navigation

<PageTitle>Sửa bảng lương</PageTitle>
<Alert @ref="alert" />

@if (dto is null)
{
    <PageLoading />
}
else
{
    <ActionTitle Text="Sửa bảng lương" />
    <EditForm Model="dto" OnSubmit="SaveAsync">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Style="max-width: 980px;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
                <FluentSelect TOption="OptionItem" TValue="string" Items="employees" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                              @bind-Value="employeeId" Label="Nhân viên" />
                <FluentDatePicker @bind-Value="startDate" Label="Từ ngày" />
                <FluentDatePicker @bind-Value="endDate" Label="Đến ngày" />
                <FluentSelect TOption="PayrollStatus?" TValue="PayrollStatus?" Items="statuses"
                              OptionText="@(x => x?.ToDisplayName())" @bind-Value="dto.PaymentStatus" Label="Trạng thái" />
            </FluentStack>
            <FluentTextInput @bind-Value="dto.Notes" Label="Ghi chú" Style="width: 420px;" />

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                <FluentSelect TOption="OptionItem" TValue="string" Items="components" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                              @bind-Value="selectedComponentId" Label="Khoản" Style="min-width: 280px;" />
                <DecimalInput @bind-Value="newQty" Label="Số lượng" Min="0" TValue="decimal" Style="width: 120px;" />
                <DecimalInput @bind-Value="newRate" Label="Đơn giá" Min="0" TValue="decimal" Unit="đ" Style="width: 160px;" />
                <FluentButton Appearance="ButtonAppearance.Outline" Style="margin-top: 34px;" OnClick="AddLine">Thêm dòng</FluentButton>
            </FluentStack>
            <FluentDataGrid Items="@lines.AsQueryable()" GridTemplateColumns="2fr 1fr 1fr 1fr .6fr">
                <PropertyColumn Title="Khoản" Property="@(c => c.Name)" />
                <TemplateColumn Title="Số lượng" Context="line"><DecimalInput @bind-Value="line.Quantity" Min="0" TValue="decimal" /></TemplateColumn>
                <TemplateColumn Title="Đơn giá" Context="line"><DecimalInput @bind-Value="line.Rate" Min="0" TValue="decimal" Unit="đ" /></TemplateColumn>
                <PropertyColumn Title="Thành tiền" Property="@(c => c.Amount.ToCurrency())" Align="DataGridCellAlignment.End" />
                <TemplateColumn Title="" Context="line"><FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => lines.Remove(line))">Xóa</FluentButton></TemplateColumn>
            </FluentDataGrid>
            <div><strong>Thực lãnh:</strong> @lines.Sum(x => x.IsEarning ? x.Amount : -x.Amount).ToCurrency()</div>
            <FormActionButtons IsSaving="@isSaving" SaveText="Lưu" CancelUrl="@($"/hr/payrolls/view/{Id}")" />
        </FluentStack>
    </EditForm>
}

@code {
    [Parameter] public required string Id { get; set; }
    private Alert? alert;
    private UpdatePayrollDto? dto;
    private PayrollDto? current;
    private List<OptionItem> employees = [];
    private List<OptionItem> components = [];
    private List<LineItem> lines = [];
    private string employeeId = "";
    private string selectedComponentId = "";
    private decimal newQty = 1;
    private decimal newRate;
    private DateTime? startDate;
    private DateTime? endDate;
    private bool isSaving;
    private static readonly IReadOnlyList<PayrollStatus?> statuses = Enum.GetValues<PayrollStatus>().Cast<PayrollStatus?>().ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        employees = ((await Lookup.GetEmployeesAsync()).Value ?? []).Select(x => new OptionItem(x.Id.ToString(), x.Label)).ToList();
        components = ((await Components.GetActiveAsync()).Value ?? []).Select(x => new OptionItem(x.Id.ToString(), $"{x.Code} - {x.Name}", x.Type == SalaryComponentType.Earning)).ToList();
        selectedComponentId = components.FirstOrDefault()?.Id ?? "";
        var update = await Service.GetUpdateByIdAsync(Id.ToGuid());
        var detail = await Service.GetByIdAsync(Id.ToGuid());
        dto = update.Value;
        current = detail.Value;
        if (dto is null || current is null)
            alert?.AddAlertError("Không tìm thấy bảng lương.");
        else
        {
            employeeId = dto.EmployeeId?.ToString() ?? "";
            startDate = dto.PeriodStartDate?.ToDateTime(TimeOnly.MinValue);
            endDate = dto.PeriodEndDate?.ToDateTime(TimeOnly.MinValue);
            lines = current.Lines.Select(x => new LineItem(x.SalaryComponentId, x.ComponentName, x.Quantity, x.Rate, x.Type == SalaryComponentType.Earning)).ToList();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void AddLine()
    {
        var component = components.FirstOrDefault(x => x.Id == selectedComponentId);
        if (component is null || !Guid.TryParse(component.Id, out var id))
            return;
        lines.Add(new LineItem(id, component.Name, newQty, newRate, component.IsEarning));
    }

    private async Task SaveAsync()
    {
        if (dto is null)
            return;
        dto.EmployeeId = Guid.TryParse(employeeId, out var empId) ? empId : null;
        dto.PeriodStartDate = startDate is null ? null : DateOnly.FromDateTime(startDate.Value);
        dto.PeriodEndDate = endDate is null ? null : DateOnly.FromDateTime(endDate.Value);
        dto.Lines = lines.Select(x => new CreatePayrollLineDto
        {
            SalaryComponentId = x.ComponentId,
            Quantity = x.Quantity,
            Rate = x.Rate,
            Amount = x.Amount
        }).ToList();
        isSaving = true;
        var result = await Service.UpdateAsync(Id.ToGuid(), dto);
        isSaving = false;
        if (!result.Succeeded)
        {
            alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không cập nhật được.");
            return;
        }
        Navigation.NavigateTo($"/hr/payrolls/view/{Id}");
    }

    private sealed record OptionItem(string Id, string Name, bool IsEarning = true);
    private sealed class LineItem(Guid componentId, string name, decimal quantity, decimal rate, bool isEarning)
    {
        public Guid ComponentId { get; } = componentId;
        public string Name { get; } = name;
        public decimal Quantity { get; set; } = quantity;
        public decimal Rate { get; set; } = rate;
        public bool IsEarning { get; } = isEarning;
        public decimal Amount => Quantity * Rate;
    }
}
