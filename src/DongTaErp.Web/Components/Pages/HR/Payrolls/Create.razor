@page "/hr/payrolls/create"
@attribute [Authorize(Roles = AppRoles.Hr)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Payrolls
@using DongTaErp.Application.Services.Lookups
@using DongTaErp.Application.Services.EmployeeCompensations
@using DongTaErp.Application.Services.SalaryComponents
@inject IPayrollService Service
@inject ILookupService Lookup
@inject IEmployeeCompensationService Compensations
@inject ISalaryComponentService Components
@inject NavigationManager Navigation

<PageTitle>Tạo bảng lương</PageTitle>
<Alert @ref="alert" />
<ActionTitle Text="Tạo bảng lương" />

<EditForm Model="dto" OnSubmit="SaveAsync">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Style="max-width: 980px;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentSelect TOption="OptionItem" TValue="string" Items="employees" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                          @bind-Value="employeeId" Label="Nhân viên" />
            <FluentDatePicker @bind-Value="startDate" Label="Từ ngày" />
            <FluentDatePicker @bind-Value="endDate" Label="Đến ngày" />
            <FluentButton Appearance="ButtonAppearance.Outline" Style="margin-top: 48px;" OnClick="LoadContractAsync">Lấy hợp đồng</FluentButton>
        </FluentStack>
        <FluentTextInput @bind-Value="dto.Notes" Label="Ghi chú" Style="width: 420px;" />

        <h4>Dòng lương</h4>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
            <FluentSelect TOption="OptionItem" TValue="string" Items="components" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                          @bind-Value="selectedComponentId" Label="Khoản" Style="min-width: 280px;" />
            <DecimalInput @bind-Value="newQty" Label="Số lượng" Min="0" TValue="decimal" Style="width: 120px;" />
            <DecimalInput @bind-Value="newRate" Label="Đơn giá" Min="0" TValue="decimal" Unit="đ" Style="width: 160px;" />
            <FluentButton Appearance="ButtonAppearance.Outline" Style="margin-top: 48px;" OnClick="AddLine">Thêm dòng</FluentButton>
        </FluentStack>

        <FluentDataGrid Items="@lines.AsQueryable()" GridTemplateColumns="2fr 1fr 1fr 1fr .6fr">
            <PropertyColumn Title="Khoản" Property="@(c => c.Name)" />
            <TemplateColumn Title="Số lượng" Context="line">
                <DecimalInput @bind-Value="line.Quantity" Min="0" TValue="decimal" />
            </TemplateColumn>
            <TemplateColumn Title="Đơn giá" Context="line">
                <DecimalInput @bind-Value="line.Rate" Min="0" TValue="decimal" Unit="đ" />
            </TemplateColumn>
            <PropertyColumn Title="Thành tiền" Property="@(c => c.Amount.ToCurrency())" Align="DataGridCellAlignment.End" />
            <TemplateColumn Title="" Context="line">
                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => lines.Remove(line))">Xóa</FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
        <div><strong>Thu nhập:</strong> @Gross.ToCurrency() &nbsp; <strong>Khấu trừ:</strong> @Deduction.ToCurrency() &nbsp; <strong>Thực lãnh:</strong> @Net.ToCurrency()</div>
        <FormActionButtons IsSaving="@isSaving" SaveText="Lưu" CancelUrl="/hr/payrolls/list" />
    </FluentStack>
</EditForm>

@code {
    private Alert? alert;
    private readonly CreatePayrollDto dto = new();
    private List<OptionItem> employees = [];
    private List<OptionItem> components = [];
    private List<LineItem> lines = [];
    private string employeeId = "";
    private string selectedComponentId = "";
    private decimal newQty = 1;
    private decimal newRate;
    private DateTime? startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? endDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month));
    private bool isSaving;
    private decimal Gross => lines.Where(x => x.IsEarning).Sum(x => x.Amount);
    private decimal Deduction => lines.Where(x => !x.IsEarning).Sum(x => x.Amount);
    private decimal Net => Gross - Deduction;

    protected override async Task OnInitializedAsync()
    {
        employees = ((await Lookup.GetEmployeesAsync()).Value ?? []).Select(x => new OptionItem(x.Id.ToString(), x.Label)).ToList();
        components = ((await Components.GetActiveAsync()).Value ?? []).Select(x => new OptionItem(x.Id.ToString(), $"{x.Code} - {x.Name}", x.Type == SalaryComponentType.Earning)).ToList();
        employeeId = employees.FirstOrDefault()?.Id ?? "";
        selectedComponentId = components.FirstOrDefault()?.Id ?? "";
    }

    private async Task LoadContractAsync()
    {
        if (!Guid.TryParse(employeeId, out var empId))
            return;
        var asOf = DateOnly.FromDateTime(startDate ?? DateTime.Today);
        var items = (await Compensations.GetActiveAsync(empId, asOf)).Value ?? [];
        foreach (var item in items.Where(x => lines.All(l => l.ComponentId != x.SalaryComponentId)))
            lines.Add(new LineItem(item.SalaryComponentId, $"{item.ComponentCode} - {item.ComponentName}", 1, item.Amount, item.Type == SalaryComponentType.Earning));
    }

    private void AddLine()
    {
        var component = components.FirstOrDefault(x => x.Id == selectedComponentId);
        if (component is null || !Guid.TryParse(component.Id, out var id) || newQty <= 0)
        {
            alert?.AddAlertError("Chọn khoản và số lượng.");
            return;
        }
        var existing = lines.FirstOrDefault(x => x.ComponentId == id);
        if (existing is not null)
        {
            existing.Quantity += newQty;
            existing.Rate = newRate;
            return;
        }
        lines.Add(new LineItem(id, component.Name, newQty, newRate, component.IsEarning));
    }

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(employeeId, out var empId))
        {
            alert?.AddAlertError("Chọn nhân viên.");
            return;
        }
        if (lines.Count == 0)
        {
            alert?.AddAlertError("Bảng lương chưa có dòng.");
            return;
        }
        dto.EmployeeId = empId;
        dto.PeriodStartDate = DateOnly.FromDateTime(startDate ?? DateTime.Today);
        dto.PeriodEndDate = DateOnly.FromDateTime(endDate ?? DateTime.Today);
        dto.PaymentStatus = PayrollStatus.Pending;
        dto.Lines = lines.Select(x => new CreatePayrollLineDto
        {
            SalaryComponentId = x.ComponentId,
            Quantity = x.Quantity,
            Rate = x.Rate,
            Amount = x.Amount
        }).ToList();
        isSaving = true;
        var result = await Service.CreateAsync(dto);
        isSaving = false;
        if (!result.Succeeded || string.IsNullOrEmpty(result.Value))
        {
            alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không tạo được bảng lương.");
            return;
        }
        Navigation.NavigateTo($"/hr/payrolls/view/{result.Value}");
    }

    private sealed record OptionItem(string Id, string Name, bool IsEarning = true);
    private sealed class LineItem(Guid componentId, string name, decimal quantity, decimal rate, bool isEarning)
    {
        public Guid ComponentId { get; } = componentId;
        public string Name { get; } = name;
        public decimal Quantity { get; set; } = quantity;
        public decimal Rate { get; set; } = rate;
        public bool IsEarning { get; } = isEarning;
        public decimal Amount => Quantity * Rate;
    }
}
