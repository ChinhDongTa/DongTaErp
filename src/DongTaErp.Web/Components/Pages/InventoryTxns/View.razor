@page "/inventory-txns/view/{Id}"
@attribute [Authorize(Roles = AppRoles.Catalog)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.InventoryTxns
@inject IInventoryTxnService Service
@inject NavigationManager Navigation

<PageTitle>Chi tiết sổ kho</PageTitle>
<Alert @ref="alert" />

@if (dto is null)
{
    <PageLoading />
}
else
{
    <ActionTitle Text="@dto.Reference" />
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Sản phẩm" Value="@($"{dto.ProductSku} - {dto.ProductName}")" />
            <DetailItem Label="Kho" Value="@dto.WarehouseName" />
            <DetailItem Label="Kho đối ứng" Value="@dto.ContraWarehouseName" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Loại" Value="@dto.TypeName" />
            <DetailItem Label="Thay đổi" Value="@dto.QtyChange.ToDisplay()" />
            <DetailItem Label="Chứng từ" Value="@dto.Reference" />
            <DetailItem Label="Ghi chú" Value="@dto.Note" />
        </FluentStack>
    </FluentStack>
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 16px;">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Navigation.NavigateTo($"/inventory-txns/update/{Id}"))">Sửa ghi chú</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => Navigation.NavigateTo("/inventory-txns/list"))">Danh sách</FluentButton>
    </FluentStack>
}

@code {
    [Parameter] public required string Id { get; set; }
    private Alert? alert;
    private InventoryTxnDto? dto;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        if (!Guid.TryParse(Id, out var id))
        {
            alert?.AddAlertError("Mã không hợp lệ.");
            return;
        }
        var result = await Service.GetByIdAsync(id);
        dto = result.Value;
        if (dto is null)
            alert?.AddAlertError("Không tìm thấy bút toán.");
        await InvokeAsync(StateHasChanged);
    }
}
