@page "/goods-receipts/list"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.GoodsReceipts
@inject NavigationManager Navigation
@inject IGoodsReceiptService Service

<PageTitle>Nhập kho</PageTitle>
<ActionTitle Text="Phiếu nhập kho" />

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin: 8px 0 12px;">
    <FluentTextInput @bind-Value="searchTerm" Placeholder="Mã phiếu, đơn mua, kho" Style="width: 280px;" @onkeypress="OnSearchKey" />
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchAsync">Tìm</FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Primary"
                  OnClick="@(() => Navigation.NavigateTo("/goods-receipts/create"))">Tạo phiếu nhập</FluentButton>
</FluentStack>

<PaginatedTable TItem="GoodsReceiptDto" Data="page" PageSize="pageSize" GridTemplateColumns="1fr 1fr 1.4fr 1fr 1fr 1.2fr" OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
    <PropertyColumn TGridItem="GoodsReceiptDto" TProp="string" Title="Mã phiếu" Property="@(c => c!.Code)" />
    <PropertyColumn TGridItem="GoodsReceiptDto" TProp="string" Title="Đơn mua" Property="@(c => c!.PurchaseOrderNumber)" />
    <PropertyColumn TGridItem="GoodsReceiptDto" TProp="string" Title="Kho nhập" Property="@(c => c!.WarehouseName)" />
    <PropertyColumn TGridItem="GoodsReceiptDto" TProp="DateTime" Title="Ngày" Property="@(c => c!.ReceiptDate)" Format="dd/MM/yyyy" />
    <TemplateColumn TGridItem="GoodsReceiptDto" Title="Trạng thái">
        <FluentBadge Appearance="@Badge(context.Status)">@context.StatusName</FluentBadge>
    </TemplateColumn>
    <TemplateColumn TGridItem="GoodsReceiptDto" Title="Thao tác" Context="item">
        <FluentButton IconStart="@(new Icons.Regular.Size20.Eye())" Appearance="ButtonAppearance.Primary" Title="Xem"
                      @onclick="@(() => Navigation.NavigateTo($"/goods-receipts/view/{item.Id}"))" />
    </TemplateColumn>
</PaginatedTable>

@code {
    private PaginatedList<GoodsReceiptDto>? page;
    private readonly int pageSize = Models.Constants.PageSize;
    private int currentPage = 1;
    private bool isLoading;
    private int requestVersion;
    private string? searchTerm;

    protected override Task OnInitializedAsync() => LoadData(1);

    private Task LoadPageAsync(int pageNumber)
    {
        currentPage = pageNumber;
        return LoadData(pageNumber);
    }

    private Task SearchAsync()
    {
        currentPage = 1;
        return LoadData(1);
    }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task LoadData(int pageNumber)
    {
        var version = ++requestVersion;
        isLoading = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await Service.SearchAsync(new SimpleSearch(searchTerm, pageNumber, pageSize));
            if (version == requestVersion && result.Succeeded)
                page = result.Value;
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
        }
    }

    private static BadgeAppearance Badge(GoodsReceiptStatus status) => status switch
    {
        GoodsReceiptStatus.Posted => BadgeAppearance.Filled,
        GoodsReceiptStatus.Cancelled => BadgeAppearance.Ghost,
        _ => BadgeAppearance.Tint
    };
}
