@page "/goods-receipts/create"
@attribute [Authorize(Roles = AppRoles.PurchaseArea)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.GoodsReceipts
@inject IGoodsReceiptService Service
@using DongTaErp.Application.Services.Lookups
@inject ILookupService Lookup
@inject NavigationManager Navigation

<PageTitle>Tạo phiếu nhập</PageTitle>
<Alert @ref="alert" />
<ActionTitle Text="Tạo phiếu nhập kho" />

<FluentMessageBar Intent="MessageBarIntent.Info" Style="margin-bottom: 12px;">
    Kho trên đơn chỉ là kho đề xuất. Kho nhập thật chọn trên phiếu. Ghi sổ mới cộng tồn.
</FluentMessageBar>

<EditForm Model="dto" OnSubmit="SaveDraftAsync">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentTextInput @bind-Value="dto.Code" Label="Mã phiếu" Required="true"  />
            <FluentSelect TValue="string" TOption="OrderOption" Items="orders" OptionText="@(x => x.Label)" OptionValue="@(x => x.Id)"
                          Value="orderId" ValueChanged="OnOrderChanged" Label="Đơn mua đã xác nhận"  />
            <FluentSelect TValue="string" TOption="WarehouseOption" Items="warehouses" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                          @bind-Value="warehouseId" Label="Kho nhập" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentDatePicker @bind-Value="receiptDate" Label="Ngày nhập" />
            <FluentTextInput @bind-Value="dto.SupplierRef" Label="Số chứng từ NCC" />
            <FluentTextInput @bind-Value="dto.Notes" Label="Ghi chú" Style="width: 450px;" />
        </FluentStack>

        <h4>Dòng nhập</h4>
        <FluentDataGrid Items="@lines.AsQueryable()" Style="width: 100%;">
            <PropertyColumn Title="Sản phẩm" Property="@(c => c.ProductLabel)" />
            <PropertyColumn Title="Đặt" Property="@(c => c.Ordered.ToDisplay())" Align="DataGridCellAlignment.End" />
            <PropertyColumn Title="Đã nhập" Property="@(c => c.Received.ToDisplay())" Align="DataGridCellAlignment.End" />
            <PropertyColumn Title="Còn lại" Property="@(c => c.Remaining.ToDisplay())" Align="DataGridCellAlignment.End" />
            <TemplateColumn Title="Nhập lần này" Context="grid">
                <FluentNumberInput @bind-Value="grid.Quantity" Min="0" TValue="decimal" />
            </TemplateColumn>
        </FluentDataGrid>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
            <FluentButton Appearance="ButtonAppearance.Outline" Type="ButtonType.Submit" Loading="isSaving">Lưu nháp</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="isSaving" OnClick="SaveAndPostAsync">Lưu và ghi sổ</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => Navigation.NavigateTo("/goods-receipts/list"))">Hủy</FluentButton>
        </FluentStack>
    </FluentStack>
</EditForm>

@code {
    private Alert? alert;
    private readonly CreateGoodsReceiptDto dto = new() { Code = "GR".GetRandomCode() };
    private DateTime? receiptDate = DateTime.Today;
    private string orderId = "";
    private string warehouseId = "";
    private bool isSaving;
    private List<OrderOption> orders = [];
    private List<WarehouseOption> warehouses = [];
    private List<ReceiptLine> lines = [];

    protected override async Task OnInitializedAsync()
    {
        orders = ((await Lookup.GetConfirmedPurchaseOrdersAsync()).Value ?? [])
            .Select(x => new OrderOption(x.Id.ToString(), x.Label, x.ExtraId?.ToString() ?? "")).ToList();
        warehouses = ((await Lookup.GetWarehousesAsync()).Value ?? [])
            .Select(x => new WarehouseOption(x.Id.ToString(), x.Label)).ToList();

        if (orders.Count > 0)
            await OnOrderChanged(orders[0].Id);
    }

    private async Task OnOrderChanged(string value)
    {
        orderId = value;
        var order = orders.FirstOrDefault(x => x.Id == value);
        if (order is null)
            return;
        warehouseId = order.WarehouseId;
        if (!Guid.TryParse(value, out var id))
            return;

        var result = await Service.GetGoodsReceiptLinesAsync(id);
        lines = (result.Value ?? []).Select(x => new ReceiptLine(x.LineId, x.ProductId, x.Label, x.OrderedQty, x.DoneQty, x.RemainingQty)).ToList();
    }

    private async Task SaveDraftAsync() => await SaveAsync(post: false);

    private async Task SaveAndPostAsync() => await SaveAsync(post: true);

    private async Task SaveAsync(bool post)
    {
        if (!Guid.TryParse(orderId, out var poId) || !Guid.TryParse(warehouseId, out var whId))
        {
            alert?.AddAlertError("Chọn đơn mua và kho nhập.");
            return;
        }

        var selected = lines.Where(x => x.Quantity > 0).ToList();
        if (selected.Count == 0)
        {
            alert?.AddAlertError("Nhập số lượng ít nhất một dòng.");
            return;
        }
        if (selected.Any(x => x.Quantity > x.Remaining))
        {
            alert?.AddAlertError("Số nhập vượt số còn lại của dòng đơn.");
            return;
        }

        dto.PurchaseOrderId = poId;
        dto.WarehouseId = whId;
        dto.ReceiptDate = receiptDate ?? DateTime.Today;
        dto.Lines = selected.Select(x => new CreateGoodsReceiptLineDto
        {
            PurchaseOrderLineId = x.PurchaseOrderLineId,
            Quantity = x.Quantity
        }).ToList();

        isSaving = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var created = await Service.CreateAsync(dto);
            if (!created.Succeeded || string.IsNullOrEmpty(created.Value))
            {
                alert?.AddAlertError(created.Errors?.FirstOrDefault() ?? "Không tạo được phiếu.");
                return;
            }

            if (post && Guid.TryParse(created.Value, out var id))
            {
                var posted = await Service.PostAsync(id);
                if (!posted.Succeeded)
                {
                    alert?.AddAlertError(posted.Errors?.FirstOrDefault() ?? "Đã lưu nháp nhưng chưa ghi sổ.");
                    Navigation.NavigateTo($"/goods-receipts/view/{created.Value}");
                    return;
                }
            }

            Navigation.NavigateTo($"/goods-receipts/view/{created.Value}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed record OrderOption(string Id, string Label, string WarehouseId);
    private sealed record WarehouseOption(string Id, string Name);
    private sealed class ReceiptLine(Guid purchaseOrderLineId, Guid productId, string productLabel, decimal ordered, decimal received, decimal remaining)
    {
        public Guid PurchaseOrderLineId { get; } = purchaseOrderLineId;
        public Guid ProductId { get; } = productId;
        public string ProductLabel { get; } = productLabel;
        public decimal Ordered { get; } = ordered;
        public decimal Received { get; } = received;
        public decimal Remaining { get; } = remaining;
        public decimal Quantity { get; set; }
    }
}
