@page "/payments/list"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Payments
@inject NavigationManager Navigation
@inject IPaymentService Service

<PageTitle>Thu tiền</PageTitle>
<ActionTitle Text="Phiếu thu" />

<FluentMessageBar Intent="MessageBarIntent.Info" Style="margin-bottom: 12px;">
    Ghi sổ phiếu thu mới trừ công nợ hóa đơn. Nháp chưa đổi số đã thu.
</FluentMessageBar>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin: 8px 0 12px;">
    <FluentTextInput @bind-Value="searchTerm" Placeholder="Số phiếu, khách, số tham chiếu" Style="width: 300px;" @onkeypress="OnSearchKey" />
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchAsync">Tìm</FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Primary"
                  OnClick="@(() => Navigation.NavigateTo("/payments/create"))">Tạo phiếu thu</FluentButton>
</FluentStack>

<PaginatedTable TItem="PaymentDto" Data="page" PageSize="pageSize"
                GridTemplateColumns="1fr 1.4fr 1fr 1fr 1fr 1fr .8fr"
                OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
    <PropertyColumn TGridItem="PaymentDto" TProp="string" Title="Số phiếu" Property="@(c => c!.Number)" />
    <PropertyColumn TGridItem="PaymentDto" TProp="string" Title="Khách hàng" Property="@(c => c!.PartnerName)" />
    <PropertyColumn TGridItem="PaymentDto" TProp="string" Title="Ngày" Property="@(c => c!.PaidAt.ToDateString())" />
    <PropertyColumn TGridItem="PaymentDto" TProp="string" Title="Số tiền" Property="@(c => c!.Amount.ToCurrency())" Align="DataGridCellAlignment.End" />
    <PropertyColumn TGridItem="PaymentDto" TProp="string" Title="Chưa phân bổ" Property="@(c => c!.UnallocatedAmount.ToCurrency())" Align="DataGridCellAlignment.End" />
    <TemplateColumn TGridItem="PaymentDto" Title="Trạng thái">
        <FluentBadge Appearance="@Badge(context.Status)">@context.StatusName</FluentBadge>
    </TemplateColumn>
    <TemplateColumn TGridItem="PaymentDto" Title="Thao tác" Context="item">
        <FluentButton IconStart="@(new Icons.Regular.Size20.Eye())" Appearance="ButtonAppearance.Primary" Title="Xem"
                      @onclick="@(() => Navigation.NavigateTo($"/payments/view/{item.Id}"))" />
    </TemplateColumn>
</PaginatedTable>

@code {
    private PaginatedList<PaymentDto>? page;
    private readonly int pageSize = Models.Constants.PageSize;
    private int currentPage = 1;
    private bool isLoading;
    private int requestVersion;
    private string? searchTerm;

    protected override Task OnInitializedAsync() => LoadData(1);

    private Task LoadPageAsync(int pageNumber)
    {
        currentPage = pageNumber;
        return LoadData(pageNumber);
    }

    private Task SearchAsync()
    {
        currentPage = 1;
        return LoadData(1);
    }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task LoadData(int pageNumber)
    {
        var version = ++requestVersion;
        isLoading = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await Service.SearchAsync(new SimpleSearch(searchTerm, pageNumber, pageSize));
            if (version == requestVersion && result.Succeeded)
                page = result.Value;
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
        }
    }

    private static BadgeAppearance Badge(CustomerPaymentStatus status) => status switch
    {
        CustomerPaymentStatus.Posted => BadgeAppearance.Ghost,
        CustomerPaymentStatus.Cancelled => BadgeAppearance.Filled,
        _ => BadgeAppearance.Outline
    };
}
