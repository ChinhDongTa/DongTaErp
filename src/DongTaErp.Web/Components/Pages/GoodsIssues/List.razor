@page "/goods-issues/list"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.GoodsIssues
@inject NavigationManager Navigation
@inject IGoodsIssueService Service

<PageTitle>Xuất kho</PageTitle>
<ActionTitle Text="Phiếu xuất kho" />

<FluentMessageBar Intent="MessageBarIntent.Info" Style="margin-bottom: 12px;">
    Xuất kho trừ tồn. Hóa đơn chỉ được lập cho số đã xuất.
</FluentMessageBar>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin: 8px 0 12px;">
    <FluentTextInput @bind-Value="searchTerm" Placeholder="Mã phiếu, đơn bán, kho" Style="width: 280px;" @onkeypress="OnSearchKey" />
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchAsync">Tìm</FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Primary"
                  OnClick="@(() => Navigation.NavigateTo("/goods-issues/create"))">Tạo phiếu xuất</FluentButton>
</FluentStack>

<PaginatedTable TItem="GoodsIssueDto" Data="page" PageSize="pageSize"
                GridTemplateColumns="1fr 1fr 1.4fr 1fr 1fr 1.2fr"
                OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
    <PropertyColumn TGridItem="GoodsIssueDto" TProp="string" Title="Mã phiếu" Property="@(c => c!.Code)" />
    <PropertyColumn TGridItem="GoodsIssueDto" TProp="string" Title="Đơn bán" Property="@(c => c!.SalesOrderNumber)" />
    <PropertyColumn TGridItem="GoodsIssueDto" TProp="string" Title="Kho xuất" Property="@(c => c!.WarehouseName)" />
    <PropertyColumn TGridItem="GoodsIssueDto" TProp="DateTime" Title="Ngày" Property="@(c => c!.IssueDate)" Format="dd/MM/yyyy" />
    <TemplateColumn TGridItem="GoodsIssueDto" Title="Trạng thái">
        <FluentBadge Appearance="@Badge(context.Status)">@context.StatusName</FluentBadge>
    </TemplateColumn>
    <TemplateColumn TGridItem="GoodsIssueDto" Title="Thao tác" Context="item">
        <FluentButton IconStart="@(new Icons.Regular.Size20.Eye())" Appearance="ButtonAppearance.Primary" Title="Xem"
                      @onclick="@(() => Navigation.NavigateTo($"/goods-issues/view/{item.Id}"))" />
    </TemplateColumn>
</PaginatedTable>

@code {
    private PaginatedList<GoodsIssueDto>? page;
    private readonly int pageSize = Models.Constants.PageSize;
    private int currentPage = 1;
    private bool isLoading;
    private int requestVersion;
    private string? searchTerm;

    protected override Task OnInitializedAsync() => LoadData(1);

    private Task LoadPageAsync(int pageNumber)
    {
        currentPage = pageNumber;
        return LoadData(pageNumber);
    }

    private Task SearchAsync()
    {
        currentPage = 1;
        return LoadData(1);
    }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task LoadData(int pageNumber)
    {
        var version = ++requestVersion;
        isLoading = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await Service.SearchAsync(new SimpleSearch(searchTerm, pageNumber, pageSize));
            if (version == requestVersion && result.Succeeded)
                page = result.Value;
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
        }
    }

    private static BadgeAppearance Badge(GoodsIssueStatus status) => status switch
    {
        GoodsIssueStatus.Posted => BadgeAppearance.Filled,
        GoodsIssueStatus.Cancelled => BadgeAppearance.Ghost,
        _ => BadgeAppearance.Outline
    };
}
