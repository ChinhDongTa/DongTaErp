@using DongTaErp.Application.Common.Models
@typeparam TItem

<FluentDataGrid TGridItem="TItem"
                Loading="IsLoading"
                Items="@itemsQuery"
                GridTemplateColumns="@GridTemplateColumns"
                Style="width: 100%;">
    @ChildContent
</FluentDataGrid>

@if (ShouldShowPaginator)
{
    <div class="pager-host">
        <FluentPaginator State="@PState" Class="my-paginator"
                         CurrentPageIndexChanged="HandlePageChanged" />
    </div>
}

@code {
    private readonly PaginationState PState = new();
    private IQueryable<TItem>? itemsQuery;
    private bool syncingPager;
    private int appliedPageSize;
    private int appliedPageNumber = -1;
    private int appliedTotal = -1;

    [Parameter] public PaginatedList<TItem>? Data { get; set; }
    [Parameter] public int PageSize { get; set; } = Models.Constants.PageSize;
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? GridTemplateColumns { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private bool ShouldShowPaginator => Data is not null && Data.TotalCount > PageSize;

    protected override async Task OnParametersSetAsync()
    {
        itemsQuery = Data?.Items?.AsQueryable();

        if (PageSize > 0 && PState.ItemsPerPage != PageSize)
            PState.ItemsPerPage = PageSize;

        var pageNumber = Data?.PageNumber ?? CurrentPage;
        var total = Data?.TotalCount ?? 0;
        if (pageNumber == appliedPageNumber && total == appliedTotal && PageSize == appliedPageSize)
            return;

        appliedPageNumber = pageNumber;
        appliedTotal = total;
        appliedPageSize = PageSize;

        syncingPager = true;
        try
        {
            await PState.SetTotalItemCountAsync(total);
            await PState.SetCurrentPageIndexAsync(Math.Max(0, pageNumber - 1));
        }
        finally
        {
            syncingPager = false;
        }
    }

    private async Task HandlePageChanged(int newPageIndex)
    {
        if (syncingPager)
            return;

        var newPageNumber = newPageIndex + 1;
        if (newPageNumber == (Data?.PageNumber ?? CurrentPage))
            return;

        if (OnPageChanged.HasDelegate)
            await OnPageChanged.InvokeAsync(newPageNumber);
    }
}