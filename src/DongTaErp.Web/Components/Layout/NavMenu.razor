@rendermode InteractiveServer

@implements IDisposable

@inject NavigationManager NavigationManager

<FluentNav Id="main-menu" Width="260px">

    <FluentNavItem Href="/" IconRest="@((new Icons.Regular.Size20.Board().WithColor(Color.Error)))" IconActive="@((new Icons.Filled.Size20.Board().WithColor(Color.Success)))">
        Dashboard
    </FluentNavItem>
    <FluentNavItem Href="/partners/list" IconRest="@(new Icons.Regular.Size20.PeopleCommunity())" IconActive="@(new Icons.Filled.Size20.PeopleCommunity())">Đối tác</FluentNavItem>
    <FluentNavItem Href="/products/list" IconRest="@(new Icons.Regular.Size20.Production())" IconActive="@(new Icons.Filled.Size20.Production())">Sản phẩm</FluentNavItem>
    <FluentNavItem Href="/warehouses/list" IconRest="@(new Icons.Regular.Size20.Box())" IconActive="@(new Icons.Filled.Size20.Box())">Kho hàng</FluentNavItem>
    <FluentNavItem Href="/warehouses/stock" IconRest="@(new Icons.Regular.Size20.ClipboardTaskListLtr())" IconActive="@(new Icons.Filled.Size20.ClipboardTaskListLtr())">Tồn kho</FluentNavItem>
    <FluentNavItem Href="/purchase-orders/list" IconRest="@(new Icons.Regular.Size20.Cart())" IconActive="@(new Icons.Filled.Size20.Cart())">Đơn mua</FluentNavItem>

    <FluentNavItem Href="/goods-receipts/list" IconRest="@(new Icons.Regular.Size20.ArrowDownload())" IconActive="@(new Icons.Filled.Size20.ArrowDownload())">Nhập kho</FluentNavItem>
    <FluentNavItem Href="/goods-issues/list" IconRest="@(new Icons.Regular.Size20.ArrowUpload())" IconActive="@(new Icons.Filled.Size20.ArrowUpload())">Xuất kho</FluentNavItem>

    <FluentNavItem Href="/invoices/list" IconRest="@(new Icons.Regular.Size20.Receipt())" IconActive="@(new Icons.Filled.Size20.Receipt())">Hóa đơn</FluentNavItem>
    <FluentNavItem Href="/auth" IconRest="@(new Icons.Regular.Size20.LockClosedKey())" IconActive="@(new Icons.Filled.Size20.LockClosedKey())">Auth Required</FluentNavItem>
    <!-- HR -->
    <FluentNavSectionHeader Title="HR" />
    <FluentNavItem Href="/hr/job-positions/list" IconRest="@((new Icons.Regular.Size20.NotePin()))" IconActive="@((new Icons.Filled.Size20.NotePin()))">Chức vụ</FluentNavItem>
    <FluentNavItem Href="/hr/departments/list" IconRest="@(new Icons.Regular.Size20.BuildingPeople())" IconActive="@(new Icons.Filled.Size20.BuildingPeople())">Phòng</FluentNavItem>
    <FluentNavItem Href="/hr/payrolls/list" IconRest="@(new Icons.Regular.Size20.PeopleMoney())" IconActive="@(new Icons.Filled.Size20.PeopleMoney())">Lương</FluentNavItem>
    <AuthorizeView>
        <Authorized>
            <FluentNavItem Href="Account/Manage">@context.User.FindFirst("DisplayName")?.Value</FluentNavItem>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <FluentButton Type="ButtonType.Submit" Style="width: 100%;">Logout</FluentButton>
            </form>
        </Authorized>
        <NotAuthorized>
            <FluentNavItem Href="Account/Register">Register</FluentNavItem>
            <FluentNavItem Href="Account/Login">Login</FluentNavItem>
        </NotAuthorized>
    </AuthorizeView>
</FluentNav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
