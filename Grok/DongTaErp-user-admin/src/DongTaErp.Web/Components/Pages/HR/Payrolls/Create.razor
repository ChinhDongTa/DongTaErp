@page "/hr/payrolls/create"
@attribute [Authorize(Roles = AppRoles.Hr)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Common.Interfaces
@using DongTaErp.Application.Services.Payrolls
@using Microsoft.EntityFrameworkCore
@inject IPayrollService Service
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation

<PageTitle>Tạo bảng lương</PageTitle>
<Alert @ref="alert" />
<ActionTitle Text="Tạo bảng lương" />

<EditForm Model="dto" OnSubmit="SaveAsync">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Style="max-width: 760px;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentSelect TOption="OptionItem" TValue="string" Items="employees" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                          @bind-Value="employeeId" Label="Nhân viên" />
            <FluentDatePicker @bind-Value="startDate" Label="Từ ngày" />
            <FluentDatePicker @bind-Value="endDate" Label="Đến ngày" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <DecimalInput @bind-Value="dto.BaseSalary" Label="Lương cơ bản" Min="0" TValue="decimal" Unit="đ" />
            <DecimalInput @bind-Value="dto.DaysWorked" Label="Ngày công" Min="0" TValue="decimal" />
            <DecimalInput @bind-Value="overtimeAmount" Label="Tăng ca" Min="0" TValue="decimal" Unit="đ" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <DecimalInput @bind-Value="bonusAmount" Label="Thưởng" Min="0" TValue="decimal" Unit="đ" />
            <DecimalInput @bind-Value="deductions" Label="Khấu trừ" Min="0" TValue="decimal" Unit="đ" />
            <FluentTextInput @bind-Value="dto.Notes" Label="Ghi chú" Style="width: 240px;" />
        </FluentStack>
        <div><strong>Thực lãnh:</strong> @Net.ToCurrency()</div>
        <FormActionButtons IsSaving="@isSaving" SaveText="Lưu" CancelUrl="/hr/payrolls/list" />
    </FluentStack>
</EditForm>

@code {
    private Alert? alert;
    private readonly CreatePayrollDto dto = new() { DaysWorked = 26 };
    private DateTime? startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? endDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month));
    private string employeeId = "";
    private decimal overtimeAmount;
    private decimal bonusAmount;
    private decimal deductions;
    private bool isSaving;
    private List<OptionItem> employees = [];
    private decimal Net => dto.BaseSalary + overtimeAmount + bonusAmount - deductions;

    protected override async Task OnInitializedAsync()
    {
        employees = await UnitOfWork.Employees.Query()
            .Where(x => x.Status != EmployeeStatus.Resigned)
            .OrderBy(x => x.Code)
            .Select(x => new OptionItem(x.Id.ToString(), $"{x.Code} - {x.FullName}"))
            .ToListAsync();
        employeeId = employees.FirstOrDefault()?.Id ?? "";
    }

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(employeeId, out var empId))
        {
            alert?.AddAlertError("Chọn nhân viên.");
            return;
        }

        dto.EmployeeId = empId;
        dto.PeriodStartDate = DateOnly.FromDateTime(startDate ?? DateTime.Today);
        dto.PeriodEndDate = DateOnly.FromDateTime(endDate ?? DateTime.Today);
        dto.OvertimeAmount = overtimeAmount;
        dto.BonusAmount = bonusAmount;
        dto.Deductions = deductions;
        dto.NetAmount = Net;
        dto.PaymentStatus = PayrollStatus.Pending;

        isSaving = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await Service.CreateAsync(dto);
            if (!result.Succeeded || string.IsNullOrEmpty(result.Value))
            {
                alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không tạo được bảng lương.");
                return;
            }
            Navigation.NavigateTo($"/hr/payrolls/view/{result.Value}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed record OptionItem(string Id, string Name);
}
