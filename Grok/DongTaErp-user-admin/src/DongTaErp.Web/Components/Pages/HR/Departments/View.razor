@attribute [Authorize(Roles = AppRoles.Hr)]
﻿@page "/hr/departments/view/{Id}"
@using DongTaErp.Application.Services.Departments
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<ActionTitle Text="Thông tin chi tiết phòng ban"/>
<Alert @ref="alertComponent" />
<div style="position:relative; margin:10px auto; max-width:50%; min-height:180px;">
    @if(dto is null)
    {
        <PageLoading />
    }
    else
    {
        <FluentStack Style="@($"margin:0; {(isLoading ? "opacity:.5; pointer-events:none;" : null)}")" HorizontalAlignment="HorizontalAlignment.Left">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                <DetailItem Label="Mã phòng ban" Value="@dto.Code" />
                <DetailItem Label="Tên phòng ban" Value="@dto.Name" />
                <DetailItem Label="Ghi chú" Value="@dto.Note" />
                <DetailItem Label="Hoạt động" Value="@dto.IsActive.ToString()" />
            </FluentStack>
            </FluentStack>
        <EntityActions EntityId="@Id" Folder="/partners" OnDeleteClick="OpenDeleteAsync" />
    }
</div>

<FluentDialog @bind-Hidden="hideDeleteDialog" Modal="true" >
    <p>Xóa @dto?.Name?</p>
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
        <FluentButton Appearance="ButtonAppearance.Primary" Loading="isDeleting" OnClick="ConfirmDeleteAsync">Xóa</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Subtle" Disabled="isDeleting" OnClick="@(() => hideDeleteDialog = true)">Hủy</FluentButton>
    </FluentStack>
</FluentDialog>

@code {
    [Parameter] public required string Id { get; set; }
    private DepartmentDto? dto;
    private Alert? alertComponent;
    private bool isLoading;
    private bool isDeleting;
    private bool hideDeleteDialog = true;
    private string? loadedId;
    private string? pendingError;
    private int requestVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == loadedId && dto is not null)
            return;

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingError is null || alertComponent is null)
            return;

        var message = pendingError;
        pendingError = null;
        alertComponent.AddAlertError(message);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        if (!Guid.TryParse(Id, out var id))
        {
            dto = null;
            loadedId = null;
            pendingError = "Mã phòng ban không hợp lệ.";
            return;
        }

        var version = ++requestVersion;
        isLoading = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var result = await DepartmentService.GetByIdAsync(id);
            if (version != requestVersion)
                return;

            if (result.Succeeded && result.Value is not null)
            {
                dto = result.Value;
                loadedId = Id;
                return;
            }

            dto = null;
            loadedId = null;
            pendingError = result.Errors?.FirstOrDefault() ?? "Không tìm thấy phòng ban.";
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
        }
    }

    private Task OpenDeleteAsync()
    {
        hideDeleteDialog = false;
        return Task.CompletedTask;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!Guid.TryParse(Id, out var id))
            return;

        isDeleting = true;
        var result = await DepartmentService.SoftDeleteAsync(id);
        isDeleting = false;

        if (!result.Succeeded)
        {
            alertComponent?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Xóa thất bại.");
            return;
        }

        Navigation.NavigateTo("/hr/departments/list");
    }
}
