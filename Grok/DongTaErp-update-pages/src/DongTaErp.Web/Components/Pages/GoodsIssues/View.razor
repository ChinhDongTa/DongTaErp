@page "/goods-issues/view/{Id}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.GoodsIssues
@inject IGoodsIssueService Service
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Phiếu xuất</PageTitle>
<Alert @ref="alert" />

@if (dto is null)
{
    <PageLoading />
}
else
{
    <ActionTitle Text="@dto.Code" />
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32" Style="margin-bottom: 12px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Đơn bán" Value="@dto.SalesOrderNumber" />
            <DetailItem Label="Kho xuất" Value="@dto.WarehouseName" />
            <DetailItem Label="Ngày xuất" Value="@dto.IssueDate.ToDateString()" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Trạng thái" Value="@dto.StatusName" />
            <DetailItem Label="Ghi chú" Value="@dto.Notes" />
        </FluentStack>
    </FluentStack>

    <FluentDataGrid Items="@dto.Lines.AsQueryable()" Style="width: 100%;">
        <PropertyColumn Title="Mã SP" Property="@(c => c.ProductSku)" />
        <PropertyColumn Title="Sản phẩm" Property="@(c => c.ProductName)" />
        <PropertyColumn Title="Số lượng" Property="@(c => c.Quantity)" Align="DataGridCellAlignment.End" />
        <PropertyColumn Title="Ghi chú" Property="@(c => c.Note)" />
    </FluentDataGrid>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 16px;">
        @if (dto.Status == GoodsIssueStatus.Draft)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="busy" OnClick="PostAsync">Ghi sổ</FluentButton>
        }
        @if (dto.Status == GoodsIssueStatus.Posted)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateInvoice">Tạo hóa đơn</FluentButton>
        }
        @if (dto.Status != GoodsIssueStatus.Cancelled)
        {
            <FluentButton Appearance="ButtonAppearance.Outline" Loading="busy" OnClick="CancelAsync">Hủy phiếu</FluentButton>
        }
        @if (dto.Status == GoodsIssueStatus.Draft)
        {
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => Navigation.NavigateTo($"/goods-issues/update/{dto.Id}"))">Sửa</FluentButton>
        }
        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => Navigation.NavigateTo("/goods-issues/list"))">Danh sách</FluentButton>
    </FluentStack>
}

@code {
    [Parameter] public required string Id { get; set; }

    private GoodsIssueDto? dto;
    private Alert? alert;
    private bool busy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Service.GetByIdAsync(Id.ToGuid());
        dto = result.Succeeded ? result.Value : null;
        if (dto is null)
            alert?.AddAlertError("Không tìm thấy phiếu xuất.");
    }

    private async Task PostAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            "Ghi sổ phiếu xuất? Tồn kho sẽ bị trừ.",
            title: "Ghi sổ",
            primaryButton: "Ghi sổ",
            secondaryButton: "Hủy");
        if (dialog.Cancelled)
            return;

        busy = true;
        var result = await Service.PostAsync(Id.ToGuid());
        busy = false;
        if (!result.Succeeded)
        {
            alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không ghi sổ được.");
            return;
        }
        await LoadAsync();
    }

    private async Task CancelAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            "Hủy phiếu xuất? Nếu đã ghi sổ, tồn sẽ được hoàn.",
            title: "Hủy phiếu",
            primaryButton: "Hủy phiếu",
            secondaryButton: "Không");
        if (dialog.Cancelled)
            return;

        busy = true;
        var result = await Service.CancelAsync(Id.ToGuid());
        busy = false;
        if (!result.Succeeded)
        {
            alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không hủy được phiếu.");
            return;
        }
        await LoadAsync();
    }

    private void CreateInvoice() => Navigation.NavigateTo("/invoices/create");
}
