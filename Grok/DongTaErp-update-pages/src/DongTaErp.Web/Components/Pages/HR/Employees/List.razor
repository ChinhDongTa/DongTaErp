@page "/hr/employees/list"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Employees
@inject NavigationManager Navigation
@inject IEmployeeService Service

<PageTitle>Nhân viên</PageTitle>
<ActionTitle Text="Nhân viên" />

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin: 8px 0 12px;">
    <FluentTextInput @bind-Value="searchTerm" Placeholder="Mã, tên, điện thoại" Style="width: 280px;" @onkeypress="OnSearchKey" />
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchAsync">Tìm</FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Primary"
                  OnClick="@(() => Navigation.NavigateTo("/hr/employees/create"))">Thêm nhân viên</FluentButton>
</FluentStack>

<PaginatedTable TItem="EmployeeDto" Data="page" PageSize="pageSize"
                GridTemplateColumns="1fr 1.6fr 1.2fr 1.2fr 1fr 1fr .8fr"
                OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
    <PropertyColumn TGridItem="EmployeeDto" TProp="string" Title="Mã" Property="@(c => c!.Code)" />
    <PropertyColumn TGridItem="EmployeeDto" TProp="string" Title="Họ tên" Property="@(c => c!.FullName)" />
    <PropertyColumn TGridItem="EmployeeDto" TProp="string" Title="Phòng" Property="@(c => c!.DepartmentName)" />
    <PropertyColumn TGridItem="EmployeeDto" TProp="string" Title="Chức vụ" Property="@(c => c!.PositionName)" />
    <PropertyColumn TGridItem="EmployeeDto" TProp="string" Title="Ngày vào" Property="@(c => c!.HireDate.ToDateString())" />
    <TemplateColumn TGridItem="EmployeeDto" Title="Trạng thái">
        <FluentBadge Appearance="BadgeAppearance.Filled">@context.Status</FluentBadge>
    </TemplateColumn>
    <TemplateColumn TGridItem="EmployeeDto" Title="Thao tác" Context="item">
        <FluentButton IconStart="@(new Icons.Regular.Size20.Eye())" Appearance="ButtonAppearance.Primary" Title="Xem"
                      @onclick="@(() => Navigation.NavigateTo($"/hr/employees/view/{item.Id}"))" />
        <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" Appearance="ButtonAppearance.Primary" Title="Sửa"
                      @onclick="@(() => Navigation.NavigateTo($"/hr/employees/update/{item.Id}"))" />
    </TemplateColumn>
</PaginatedTable>

@code {
    private PaginatedList<EmployeeDto>? page;
    private readonly int pageSize = Models.Constants.PageSize;
    private int currentPage = 1;
    private bool isLoading;
    private int requestVersion;
    private string? searchTerm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadData(1);
    }
    private Task LoadPageAsync(int pageNumber) { currentPage = pageNumber; return LoadData(pageNumber); }
    private Task SearchAsync() { currentPage = 1; return LoadData(1); }
    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task LoadData(int pageNumber)
    {
        var version = ++requestVersion;
        isLoading = true;
      
        try
        {
            var result = await Service.SearchAsync(new SimpleSearch(searchTerm, pageNumber, pageSize));
            if (version == requestVersion && result.Succeeded)
                page = result.Value;
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
