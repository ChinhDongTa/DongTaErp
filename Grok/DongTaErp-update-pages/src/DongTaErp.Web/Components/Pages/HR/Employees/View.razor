@page "/hr/employees/view/{Id}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Employees
@inject IEmployeeService Service
@inject NavigationManager Navigation

<PageTitle>Nhân viên</PageTitle>
<Alert @ref="alert" />

@if (dto is null)
{
    <PageLoading />
}
else
{
    <ActionTitle Text="@dto.FullName" />
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="32">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Mã" Value="@dto.Code" />
            <DetailItem Label="CCCD" Value="@dto.IdentityNumber" />
            <DetailItem Label="Phòng" Value="@dto.DepartmentName" />
            <DetailItem Label="Chức vụ" Value="@dto.PositionName" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <DetailItem Label="Giới tính" Value="@dto.Gender" />
            <DetailItem Label="Ngày vào" Value="@dto.HireDate.ToDateString()" />
            <DetailItem Label="Điện thoại" Value="@dto.Phone" />
            <DetailItem Label="Trạng thái" Value="@dto.Status" />
        </FluentStack>
    </FluentStack>
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin-top: 16px;">
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Navigation.NavigateTo("/hr/leave-requests/create"))">Tạo đơn nghỉ</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Navigation.NavigateTo("/hr/payrolls/create"))">Tạo bảng lương</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => Navigation.NavigateTo($"/hr/employees/update/{dto.Id}"))">Sửa</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => Navigation.NavigateTo("/hr/employees/list"))">Danh sách</FluentButton>
    </FluentStack>
}

@code {
    [Parameter] public required string Id { get; set; }
    private EmployeeDto? dto;
    private Alert? alert;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Service.GetByIdAsync(Id.ToGuid());
        dto = result.Succeeded ? result.Value : null;
        if (dto is null)
            alert?.AddAlertError("Không tìm thấy nhân viên.");
    }
}
