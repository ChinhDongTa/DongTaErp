@page "/sales-orders/list"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.SalesOrders
@inject NavigationManager Navigation
@inject ISalesOrderService Service

<PageTitle>Đơn bán</PageTitle>
<ActionTitle Text="Đơn bán" />

<FluentMessageBar Intent="MessageBarIntent.Info" Style="margin-bottom: 12px;">
    Chọn sản phẩm ở đơn bán. Xác nhận đơn chưa trừ kho và chưa ra hóa đơn.
</FluentMessageBar>

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin: 8px 0 12px;">
    <FluentTextInput @bind-Value="searchTerm" Placeholder="Số đơn, khách hàng" Style="width: 280px;" @onkeypress="OnSearchKey" />
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchAsync">Tìm</FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Primary"
                  OnClick="@(() => Navigation.NavigateTo("/sales-orders/create"))">Tạo đơn bán</FluentButton>
</FluentStack>

<PaginatedTable TItem="SalesOrderDto" Data="page" PageSize="pageSize"
                GridTemplateColumns="1fr 1.6fr 1.3fr 1fr 1fr 1fr .8fr"
                OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
    <PropertyColumn TGridItem="SalesOrderDto" TProp="string" Title="Số đơn" Property="@(c => c!.Number)" />
    <PropertyColumn TGridItem="SalesOrderDto" TProp="string" Title="Khách hàng" Property="@(c => c!.PartnerName)" />
    <PropertyColumn TGridItem="SalesOrderDto" TProp="string" Title="Kho đề xuất" Property="@(c => c!.WarehouseName)" />
    <PropertyColumn TGridItem="SalesOrderDto" TProp="string" Title="Ngày" Property="@(c => c!.OrderDate.ToDateString())" />
    <PropertyColumn TGridItem="SalesOrderDto" TProp="string" Title="Tổng" Property="@(c => c!.Total.ToCurrency())" Align="DataGridCellAlignment.End" />
    <TemplateColumn TGridItem="SalesOrderDto" Title="Trạng thái">
        <FluentBadge Appearance="@Badge(context.Status)">@context.StatusName</FluentBadge>
    </TemplateColumn>
    <TemplateColumn TGridItem="SalesOrderDto" Title="Thao tác" Context="item">
        <FluentButton IconStart="@(new Icons.Regular.Size20.Eye())" Appearance="ButtonAppearance.Primary" Title="Xem"
                      @onclick="@(() => Navigation.NavigateTo($"/sales-orders/view/{item.Id}"))" />
        <FluentButton IconStart="@(new Icons.Regular.Size20.Edit())" Appearance="ButtonAppearance.Primary" Title="Sửa"
                      @onclick="@(() => Navigation.NavigateTo($"/sales-orders/update/{item.Id}"))" />
    </TemplateColumn>
</PaginatedTable>

@code {
    private PaginatedList<SalesOrderDto>? page;
    private readonly int pageSize = Models.Constants.PageSize;
    private int currentPage = 1;
    private bool isLoading;
    private int requestVersion;
    private string? searchTerm;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadData(1);
    }

    private Task LoadPageAsync(int pageNumber)
    {
        currentPage = pageNumber;
        return LoadData(pageNumber);
    }

    private Task SearchAsync()
    {
        currentPage = 1;
        return LoadData(1);
    }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task LoadData(int pageNumber)
    {
        var version = ++requestVersion;
        isLoading = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await Service.SearchAsync(new SimpleSearch(searchTerm, pageNumber, pageSize));
            if (version == requestVersion && result.Succeeded)
                page = result.Value;
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
        }
    }

    private static BadgeAppearance Badge(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Confirmed => BadgeAppearance.Ghost,
        SalesOrderStatus.Cancelled => BadgeAppearance.Filled,
        _ => BadgeAppearance.Tint
    };
}