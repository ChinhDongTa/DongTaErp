@page "/hr/employees/create"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Common.Interfaces
@using DongTaErp.Application.Services.Employees
@using Microsoft.EntityFrameworkCore
@inject IEmployeeService Service
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation

<PageTitle>Thêm nhân viên</PageTitle>
<Alert @ref="alert" />
<ActionTitle Text="Thêm nhân viên" />

<EditForm Model="dto" OnSubmit="SaveAsync">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Style="max-width: 760px;">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentTextInput @bind-Value="dto.Code" Label="Mã nhân viên" Required="true" />
            <FluentTextInput @bind-Value="dto.FullName" Label="Họ tên" Required="true" Style="width: 280px;" />
            <FluentTextInput @bind-Value="dto.IdentityNumber" Label="CCCD" Required="true" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentSelect TOption="OptionItem" TValue="string" Items="departments" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                          @bind-Value="departmentId" Label="Phòng ban" />
            <FluentSelect TOption="OptionItem" TValue="string" Items="positions" OptionText="@(x => x.Name)" OptionValue="@(x => x.Id)"
                          @bind-Value="positionId" Label="Chức vụ" />
            <FluentSelect TOption="GenderOption" TValue="Gender" Items="genders" OptionText="@(x => x.Name)" OptionValue="@(x => x.Value)"
                          @bind-Value="dto.Gender" Label="Giới tính" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentDatePicker @bind-Value="hireDate" Label="Ngày vào làm" />
            <FluentDatePicker @bind-Value="birthDate" Label="Ngày sinh" />
            <FluentSelect TOption="StatusOption" TValue="EmployeeStatus" Items="statuses" OptionText="@(x => x.Name)" OptionValue="@(x => x.Value)"
                          @bind-Value="dto.Status" Label="Trạng thái" />
        </FluentStack>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12">
            <FluentTextInput @bind-Value="dto.Phone" Label="Điện thoại" />
            <FluentTextInput @bind-Value="dto.Email" Label="Email" />
            <FluentTextInput @bind-Value="dto.Address" Label="Địa chỉ" Style="width: 280px;" />
        </FluentStack>
        <FormActionButtons IsSaving="@isSaving" SaveText="Lưu" CancelUrl="/hr/employees/list" />
    </FluentStack>
</EditForm>

@code {
    private Alert? alert;
    private readonly CreateEmployeeDto dto = new() { Code = "NV".GetRandomCode(), FullName = "", IdentityNumber = "", Status = EmployeeStatus.Working };
    private DateTime? hireDate = DateTime.Today;
    private DateTime? birthDate;
    private string departmentId = "";
    private string positionId = "";
    private bool isSaving;
    private List<OptionItem> departments = [];
    private List<OptionItem> positions = [];
    private readonly List<GenderOption> genders = [new(Gender.Male, "Nam"), new(Gender.Female, "Nữ"), new(Gender.Other, "Khác")];
    private readonly List<StatusOption> statuses =
    [
        new(EmployeeStatus.Probation, "Thử việc"),
        new(EmployeeStatus.Working, "Đang làm việc"),
        new(EmployeeStatus.OnLeave, "Đang nghỉ phép"),
        new(EmployeeStatus.Resigned, "Đã nghỉ việc")
    ];

    protected override async Task OnInitializedAsync()
    {
        departments = await UnitOfWork.Departments.Query()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Code)
            .Select(x => new OptionItem(x.Id.ToString(), $"{x.Code} - {x.Name}"))
            .ToListAsync();
        positions = await UnitOfWork.JobPositions.Query()
            .Where(x => x.IsActive)
            .OrderBy(x => x.Code)
            .Select(x => new OptionItem(x.Id.ToString(), $"{x.Code} - {x.Name}"))
            .ToListAsync();
        departmentId = departments.FirstOrDefault()?.Id ?? "";
        positionId = positions.FirstOrDefault()?.Id ?? "";
    }

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(departmentId, out var depId) || !Guid.TryParse(positionId, out var posId))
        {
            alert?.AddAlertError("Chọn phòng ban và chức vụ.");
            return;
        }

        dto.DepartmentId = depId;
        dto.PositionId = posId;
        dto.HireDate = hireDate ?? DateTime.Today;
        dto.BirthDate = birthDate;

        isSaving = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await Service.CreateAsync(dto);
            if (!result.Succeeded || string.IsNullOrEmpty(result.Value))
            {
                alert?.AddAlertError(result.Errors?.FirstOrDefault() ?? "Không thêm được nhân viên.");
                return;
            }
            Navigation.NavigateTo($"/hr/employees/view/{result.Value}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed record OptionItem(string Id, string Name);
    private sealed record GenderOption(Gender Value, string Name);
    private sealed record StatusOption(EmployeeStatus Value, string Name);
}
