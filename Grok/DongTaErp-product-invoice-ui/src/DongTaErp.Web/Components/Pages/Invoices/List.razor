@page "/invoices/list"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using DongTaErp.Application.Services.Invoices
@inject NavigationManager Navigation
@inject IInvoiceService Service

<PageTitle>Hóa đơn</PageTitle>
<ActionTitle Text="Hóa đơn bán" />

<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8" Style="margin: 8px 0 12px;">
    <FluentSearch @bind-Value="searchTerm" Placeholder="Số hóa đơn, khách, đơn bán" Style="width: 300px;" @onkeypress="OnSearchKey" />
    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="SearchAsync">Tìm</FluentButton>
    <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Appearance="ButtonAppearance.Primary"
                  OnClick="@(() => Navigation.NavigateTo("/invoices/create"))">Tạo hóa đơn</FluentButton>
</FluentStack>

<PaginatedTable TItem="InvoiceDto" Data="page" PageSize="pageSize"
                GridTemplateColumns="1fr 1.4fr 1fr 1fr 1fr 1fr 1fr .8fr"
                OnPageChanged="LoadPageAsync" CurrentPage="currentPage" IsLoading="isLoading">
    <PropertyColumn TGridItem="InvoiceDto" TProp="string" Title="Số HĐ" Property="@(c => c!.Number)" />
    <PropertyColumn TGridItem="InvoiceDto" TProp="string" Title="Khách hàng" Property="@(c => c!.PartnerName)" />
    <PropertyColumn TGridItem="InvoiceDto" TProp="string" Title="Đơn bán" Property="@(c => c!.SalesOrderNumber)" />
    <PropertyColumn TGridItem="InvoiceDto" TProp="DateTime" Title="Ngày" Property="@(c => c!.IssueDate)" Format="dd/MM/yyyy" />
    <PropertyColumn TGridItem="InvoiceDto" TProp="decimal" Title="Tổng" Property="@(c => c!.Total)" Format="N0" Align="DataGridCellAlignment.End" />
    <PropertyColumn TGridItem="InvoiceDto" TProp="decimal" Title="Còn nợ" Property="@(c => c!.Balance)" Format="N0" Align="DataGridCellAlignment.End" />
    <TemplateColumn TGridItem="InvoiceDto" Title="Trạng thái">
        <FluentBadge Appearance="@Badge(context.Status)">@context.StatusName</FluentBadge>
    </TemplateColumn>
    <TemplateColumn TGridItem="InvoiceDto" Title="Thao tác" Context="item">
        <FluentButton IconStart="@(new Icons.Regular.Size20.Eye())" Appearance="ButtonAppearance.Primary" Title="Xem"
                      @onclick="@(() => Navigation.NavigateTo($"/invoices/view/{item.Id}"))" />
    </TemplateColumn>
</PaginatedTable>

@code {
    private PaginatedList<InvoiceDto>? page;
    private readonly int pageSize = Models.Constants.PageSize;
    private int currentPage = 1;
    private bool isLoading;
    private int requestVersion;
    private string? searchTerm;

    protected override Task OnInitializedAsync() => LoadData(1);

    private Task LoadPageAsync(int pageNumber)
    {
        currentPage = pageNumber;
        return LoadData(pageNumber);
    }

    private Task SearchAsync()
    {
        currentPage = 1;
        return LoadData(1);
    }

    private Task OnSearchKey(KeyboardEventArgs e) => e.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task LoadData(int pageNumber)
    {
        var version = ++requestVersion;
        isLoading = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            var result = await Service.SearchAsync(new SimpleSearch(searchTerm, pageNumber, pageSize));
            if (version == requestVersion && result.Succeeded)
                page = result.Value;
        }
        finally
        {
            if (version == requestVersion)
                isLoading = false;
        }
    }

    private static Appearance Badge(InvoiceStatus status) => status switch
    {
        InvoiceStatus.Paid => Appearance.Accent,
        InvoiceStatus.PartiallyPaid => Appearance.Lightweight,
        InvoiceStatus.Cancelled => Appearance.Neutral,
        _ => Appearance.Neutral
    };
}
